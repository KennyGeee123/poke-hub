{
  "name": "PokéVault",
  "short_name": "PokéVault",
  "description": "Scan Pokémon cards, track market prices, and manage your collection. Unofficial fan app.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0b1020",
