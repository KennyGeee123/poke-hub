# Client (Vite) — safe to expose in the browser bundle
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Optional: comma-separated owner emails that unlock Elite without paywall
VITE_OWNER_EMAIL=

# Public support address shown in legal pages / store docs
VITE_SUPPORT_EMAIL=kmitchjr7@gmail.com

# Server-only (Nitro / Vercel). NEVER prefix these with VITE_
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI gateway
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=

# NOT client env — configure in Supabase dashboard, not here:
#   Auth → Providers → Google (Client ID / Secret)
#   Auth → Providers → Apple (Services ID, Team ID, Key ID, .p8)
# Redirect URLs must include:
#   https://pokedex-hub-lime.vercel.app/login
#   https://pokedex-hub-lime.vercel.app/**
#   com.kennygeee.pokevault://auth/callback
#   http://localhost:3000/login (and :5173 / :8080 as needed)
